# Server & Environment
BACKEND_PORT=5000
PORT=5000
NODE_ENV=development
APP_URL="http://localhost:5000"

# MongoDB Atlas connection string (never commit real credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Explicit local-only development fallback; ignored in production.
LOCAL_STORE=false

# Set to "true" to seed sample data. Seeding is disabled unless explicitly enabled.
SEED_INITIAL_DATA=false
